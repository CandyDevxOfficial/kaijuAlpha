-- 4. ระบบเบื้องหลัง (Force Velocity)
local player = game.Players.LocalPlayer
local currentForce = 0
local isMoving = false

game:GetService("RunService").Heartbeat:Connect(function()
    if isMoving then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        if hrp and hum then
            -- ถ้ามีการกดเดิน ให้ใส่แรงพุ่งไปทิศนั้น
            if hum.MoveDirection.Magnitude > 0 then
                hrp.Velocity = Vector3.new(hum.MoveDirection.X * currentForce, hrp.Velocity.Y, hum.MoveDirection.Z * currentForce)
            end
        end
    end
end)

-- 5. เมื่อกดปุ่มเริ่ม
StartBtn.MouseButton1Click:Connect(function()
    local val = tonumber(SpeedInput.Text)
    if val then
        currentForce = val
        isMoving = true
        StartBtn.Text = "เริ่มแล้วความเร็วเดิน/วิ่งอยู่ที่: " .. val
        StartBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0) -- เปลี่ยนเป็นสีเขียวเมื่อทำงาน
    else
        StartBtn.Text = "คุณยังไม่ได้ใส่ตัวเลข"
        wait(1)
        StartBtn.Text = "เริ่มความเร็วในการเดิน/วิ่ง!"
    end
end)
