-- 0. ระบบ Anti-Ban Bypass (ป้องกันการตรวจจับเบื้องต้น)
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    -- ป้องกันไม่ให้เกมส่งคำสั่ง Kick หรือส่ง Log การโกงกลับไป
    if tostring(method) == "Kick" or tostring(method) == "reportAbuse" then
        return nil
    end
    return oldNamecall(self, unpack(args))
end)
setreadonly(mt, true)

